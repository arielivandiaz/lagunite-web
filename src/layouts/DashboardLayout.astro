---
import "../../../dist/lagunite.css";
import DashboardNavbar from "../components/dashboard/DashboardNavbar.astro";
import DashboardSidebar from "../components/dashboard/DashboardSidebar.astro";

export interface Props {
  title?: string;
}

const { title = "Dashboard" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Lagunite</title>
  </head>
  <body>
    <DashboardNavbar title={title} />

    <div class="dashboard-shell">
      <DashboardSidebar current={currentPath} />
      <main class="dashboard-main">
        <slot />
      </main>
    </div>

    <div id="dashboard-overlay" class="dashboard-overlay" aria-hidden="true"></div>
  </body>
</html>

<script>
  (function () {
    const sidebar = document.getElementById("dashboard-sidebar");
    const overlay = document.getElementById("dashboard-overlay");
    const toggle = document.getElementById("dashboard-menu-toggle");

    function isMobile() {
      return window.innerWidth < 900;
    }

    function setOpen(open: boolean) {
      sidebar?.classList.toggle("is-open", open);
      overlay?.classList.toggle("is-visible", open && isMobile());
      toggle?.setAttribute("aria-expanded", String(open));
    }

    function closeSidebarOnMobile() {
      if (isMobile()) setOpen(false);
      if (!isMobile()) setOpen(true);
    }

    setOpen(!isMobile());

    toggle?.addEventListener("click", function () {
      const open = sidebar?.classList.contains("is-open") ?? false;
      setOpen(!open);
    });

    overlay?.addEventListener("click", function () {
      setOpen(false);
    });

    window.addEventListener("resize", closeSidebarOnMobile);
  })();
</script>
