---
export interface Props {
  href?: string;
  icon?: string;
  label?: string;
}

const { href = "/dashboard-alt", icon = "✦", label = "Home" } = Astro.props as Props;
---

<a class="sidebar-brand-top" href={href} aria-label={label} title={label}>
  <span class="sidebar-brand-top__icon" aria-hidden="true">{icon}</span>
</a>
