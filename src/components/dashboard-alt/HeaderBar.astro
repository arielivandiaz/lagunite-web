---
export interface Props {
  title: string;
  subtitle?: string;
  href?: string;
}

const { title, subtitle = "", href = "/dashboard-alt" } = Astro.props as Props;
---

<a class="dashboard-header-bar" href={href}>
  <span class="dashboard-header-bar__content">
    <span class="dashboard-header-bar__title">{title}</span>
    {subtitle ? <span class="dashboard-header-bar__subtitle">{subtitle}</span> : null}
  </span>
</a>
