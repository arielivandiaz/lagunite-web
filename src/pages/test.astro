---
import DocLayout from "../layouts/DocLayout.astro";
---

<DocLayout title="Layout Test">
  <section class="container container-m padd-v-l padd-h">
    <h1>DocLayout test page</h1>
    <p class="marg-t-s">
      This page uses the new layout. It also includes a native Lagunite email input sample.
    </p>

    <div class="marg-t padd border-r-l bg-white">
      <label for="demo-email" class="font-weight-2 d-block marg-b-s">Email</label>
      <input
        id="demo-email"
        type="email"
        class="input"
        placeholder="name@company.com"
        autocomplete="email"
      />
    </div>
  </section>
</DocLayout>
