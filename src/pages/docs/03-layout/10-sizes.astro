      <div>
        <h3>Intrinsic Sizing</h3>
        <i>@ID:<b>#03-10-01</b></i>
        <div class="separator-v-s"></div>
        <div class="col g-gap-m marg-b-s">
          <div class="row ai-c">
            <code class="marg-rg">.w-auto</code>
            <div class="w-auto bg-1 padd-xs">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit.
            </div>
          </div>
          <i>width depends on parent/flow (auto)</i>
        </div>

        <div class="col g-gap-m marg-b-s">
          <div class="row ai-c">
            <code class="marg-rg">.h-auto</code>
            <div class="h-auto bg-1 padd-xs">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit.
            </div>
          </div>
          <i>height depends on parent/flow (auto)</i>
        </div>

