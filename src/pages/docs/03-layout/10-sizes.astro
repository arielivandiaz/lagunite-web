            </div>
          </div>
          <i>height shrinks to minimum content size (min-content)</i>
        </div>

        <div class="col g-gap-m marg-b-s">
          <div class="row ai-c">
            <code class="marg-rg">.wfc<br />.wfit<br />.w-fit</code>
            <div class="w-fit bg-1 padd-xs">
