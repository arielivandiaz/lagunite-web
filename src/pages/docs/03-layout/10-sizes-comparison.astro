---
import Layout from "../../../layouts/Layout.astro";
import RectangleDemo from "../../../components/docs/RectangleDemo.astro";

const title = "Comparison of Fluid Sizes vs Fixed Sizes";
---

<Layout title={title}>
  <section class="w-max center padd">
    <h2>{title}</h2>

    <div class="separator-v-l"></div>
    <div>
      <h3>Width</h3>
      <i
        >Comparison of fixed widths (.w1, .w2, etc.) vs fluid widths (.wf1,
        .wf2, etc.). Resize the window to see the effect.</i
      >
      <div class="separator-v"></div>
      <div class="ta-lf maxvw90 overflow-x-auto">
        <div>
          <code>.w1</code>: <i> width: var(--space-12); <b>&nbsp; 48px </b> </i>
        </div>
        <div>
          <code>.wf1</code>: <i>
            width: clamp(var(--space-8), 3dvw, var(--space-12)) <b
              >&nbsp; max: 48px
            </b>
          </i>
        </div>
        <div class="separator-v-xs"></div>
        <div class="bg-1 h1 w1 border marg-b-xs bordered"></div>
        <div class="bg-1 h1 wf1 border marg-b-xs bordered"></div>

        <div>
          <code>.w2</code>: <i> width: var(--space-16); <b>&nbsp; 64px </b> </i>
        </div>
        <div>
          <code>.wf2</code>: <i>
            width:clamp(var(--space-10), 6dvw, var(--space-16)) <b
              >&nbsp; max: 64px
            </b>
          </i>
        </div>
        <div class="separator-v-xs"></div>
        <div class="bg-1 h1 w2 border marg-b-xs bordered"></div>
        <div class="bg-1 h1 wf2 border marg-b-xs bordered"></div>

        <div>
          <code>.w3</code>: <i> width: var(--space-20); <b>&nbsp; 80px </b> </i>
        </div>
        <div>
          <code>.wf3</code>: <i>
            width: clamp(var(--space-12), 10dvw, var(--space-20)) <b
              >&nbsp; max: 80px
            </b>
          </i>
        </div>
        <div class="separator-v-xs"></div>
        <div class="bg-1 h1 w3 border marg-b-xs bordered"></div>
        <div class="bg-1 h1 wf3 border marg-b-xs bordered"></div>

        <div>
          <code>.w4</code>: <i> width: var(--space-24); <b>&nbsp; 96px </b> </i>
        </div>
        <div>
          <code>.wf4</code>: <i>
            width: clamp(var(--space-16), 12dvw, var(--space-24)) <b
              >&nbsp; max: 96px
            </b>
          </i>
        </div>
        <div class="separator-v-xs"></div>
        <div class="bg-1 h1 w4 border marg-b-xs bordered"></div>
        <div class="bg-1 h1 wf4 border marg-b-xs bordered"></div>

        <div>
          <code>.w5</code>: <i>
            width: var(--space-32); <b>&nbsp; 128px </b>
          </i>
        </div>
        <div>
          <code>.wf5</code>: <i>
            width: clamp(var(--space-20), 15dvw, var(--space-32)) <b
              >&nbsp; max: 128px
            </b>
          </i>
        </div>
        <div class="separator-v-xs"></div>
        <div class="bg-1 h1 w5 border marg-b-xs bordered"></div>
        <div class="bg-1 h1 wf5 border marg-b-xs bordered"></div>

        <div>
          <code>.w6</code>: <i>
            width: calc(var(--space-32) * 1.5); <b>&nbsp; 192px </b>
          </i>
        </div>
        <div>
          <code>.wf6</code>: <i>
            width: clamp(var(--space-24), 22dvw, calc(var(--space-32) * 1.5)) <b
              >&nbsp; max: 192px
            </b>
          </i>
        </div>
        <div class="separator-v-xs"></div>
        <div class="bg-1 h1 w6 border marg-b-xs bordered"></div>
        <div class="bg-1 h1 wf6 border marg-b-xs bordered"></div>

        <div>
          <code>.w7</code>: <i>
            width: calc(var(--space-32) * 2); <b>&nbsp; 256px </b>
          </i>
        </div>
        <div>
          <code>.wf7</code>: <i>
            width: clamp(var(--space-32), 26dvw, calc(var(--space-32) * 2)) <b
              >&nbsp; max: 256px
            </b>
          </i>
        </div>
        <div class="separator-v-xs"></div>
        <div class="bg-1 h1 w7 border marg-b-xs bordered"></div>
        <div class="bg-1 h1 wf7 border marg-b-xs bordered"></div>

        <div>
          <code>.w8</code>: <i>
            width: calc(var(--space-32) * 3.5); <b>&nbsp;448px </b>
          </i>
        </div>
        <div>
          <code>.wf8</code>: <i>
            width: clamp(var(--space-12), 32dvw, calc(var(--space-32) * 3.5)) <b
              >&nbsp; max: 448px
            </b>
          </i>
        </div>
        <div class="separator-v-xs"></div>
        <div class="bg-1 h1 w8 border marg-b-xs bordered"></div>
        <div class="bg-1 h1 wf8 border marg-b-xs bordered"></div>

        <div>
          <code>.w9</code>: <i>
            width: calc(var(--space-32) * 4); <b>&nbsp; 512px </b>
          </i>
        </div>
        <div>
          <code>.wf9</code>: <i>
            width: clamp(var(--space-12), 42dvw, calc(var(--space-32) * 4)) <b
              >&nbsp; max: 512px
            </b>
          </i>
        </div>
        <div class="separator-v-xs"></div>
        <div class="bg-1 h1 w9 border marg-b-xs bordered"></div>
        <div class="bg-1 h1 wf9 border marg-b-xs bordered"></div>

        <div>
          <code>.w10</code>: <i>
            width: calc(var(--space-32) * 5); <b>&nbsp; 640px </b>
          </i>
        </div>
        <div>
          <code>.wf10</code>: <i>
            width: clamp(var(--space-12), 50dvw, calc(var(--space-32) * 5)) <b
              >&nbsp; max: 640px
            </b>
          </i>
        </div>
        <div class="separator-v-xs"></div>
        <div class="bg-1 h1 w10 border marg-b-xs bordered"></div>
        <div class="bg-1 h1 wf10 border marg-b-xs bordered"></div>

        <div>
          <code>.w11</code>: <i>
            width: calc(var(--space-32) * 6); <b>&nbsp; 768px </b>
          </i>
        </div>
        <div>
          <code>.wf11</code>: <i>
            width: clamp(var(--space-12), 75dvw, calc(var(--space-32) * 6)) <b
              >&nbsp; max: 768px
            </b>
          </i>
        </div>
        <div class="separator-v-xs"></div>
        <div class="bg-1 h1 w11 border marg-b-xs bordered"></div>
        <div class="bg-1 h1 wf11 border marg-b-xs bordered"></div>

        <div>
          <code>.w12</code>: <i>
            width: calc(var(--space-32) * 8); <b>&nbsp; 1024px </b>
          </i>
        </div>
        <div>
          <code>.wf12</code>: <i>
            width: clamp(var(--space-12), 90dvw, calc(var(--space-32) * 8)) <b
              >&nbsp; max: 1024px
            </b>
          </i>
        </div>
        <div class="separator-v-xs"></div>
        <div class="bg-1 h1 w12 border marg-b-xs bordered"></div>
        <div class="bg-1 h1 wf12 border marg-b-xs bordered"></div>
      </div>
    </div>
    <div>
      <div class="separator-v-l"></div>
      <div>
      <h3>Height</h3>
      <i
        >Comparison of fixed heights (.h1, .h2, etc.) vs fluid heights (.hf1,
        .hf2, etc.). Resize the window to see the effect.</i
      >
        <div class="separator-v"></div>
        <div class="col">
          <div class="col-row">
            <div class="ta-lf">
              <div>
                <code>.h1</code>: <i>
                  height: var(--space-5); <b>&nbsp; 20px </b>
                </i>
              </div>
              <div>
                <code>.h2</code>: <i>
                  height: var(--space-8); <b>&nbsp; 32px </b>
                </i>
              </div>
              <div>
                <code>.h3</code>: <i>
                  height: var(--space-10); <b>&nbsp; 40px </b>
                </i>
              </div>
              <div>
                <code>.h4</code>: <i>
                  height: var(--space-16); <b>&nbsp; 64px </b>
                </i>
              </div>
              <div>
                <code>.h5</code>: <i>
                  height: var(--space-20); <b>&nbsp; 80px </b>
                </i>
              </div>
              <div>
                <code>.h6</code>: <i>
                  height: var(--space-24); <b>&nbsp; 96px </b>
                </i>
              </div>
              <div>
                <code>.h7</code>: <i>
                  height: var(--space-32); <b>&nbsp; 128px </b>
                </i>
              </div>
              <div>
                <code>.h8</code>: <i>
                  height: calc(var(--space-32) * 1.5); <b>&nbsp; 192px </b>
                </i>
              </div>
              <div>
                <code>.h9</code>: <i>
                  height: calc(var(--space-32) * 2); <b>&nbsp; 256px </b>
                </i>
              </div>
              <div>
                <code>.h10</code>: <i>
                  height: calc(var(--space-32) * 2.5); <b>&nbsp; 384px </b>
                </i>
              </div>
              <div>
                <code>.h11</code>: <i>
                  height: calc(var(--space-32) * 3); <b>&nbsp; 384px </b>
                </i>
              </div>
              <div>
                <code>.h12</code>: <i>
                  height: calc(var(--space-32) * 3.5); <b>&nbsp; 448px </b>
                </i>
              </div>
              <div>
                <code>.h13</code>: <i>
                  height: calc(var(--space-32) * 4); <b>&nbsp; 512px </b>
                </i>
              </div>
              <div>
                <code>.h14</code>: <i>
                  height: calc(var(--space-32) * 5); <b>&nbsp; 640px </b>
                </i>
              </div>
              <div>
                <code>.h15</code>: <i>
                  height: calc(var(--space-32) * 6); <b>&nbsp; 768px </b>
                </i>
              </div>
            </div>
            <div class="dseparator-h-l"></div>
            <div class="ta-lf">
              <div>
                <code>.hf1 </code>:
                <i>
                  height: clamp(var(--space-2), 2dvh, var(--space-5));<b
                    >&nbsp; max: 20px</b
                  ></i
                >
              </div>
              <div>
                <code>.hf2 </code>:
                <i>
                  height: clamp(var(--space-4), 3.5dvh, var(--space-8));<b
                    >&nbsp; max: 32px</b
                  ></i
                >
              </div>
              <div>
                <code>.hf3 </code>:
                <i>
                  height: clamp(var(--space-5), 4.5dvh, var(--space-10));<b
                    >&nbsp; max: 40px
                  </b></i
                >
              </div>
              <div>
                <code>.hf4 </code>:
                <i>
                  height: clamp(var(--space-8), 7dvh, var(--space-16));<b
                    >&nbsp; max: 64px</b
                  ></i
                >
              </div>
              <div>
                <code>.hf5 </code>:
                <i>
                  height: clamp(var(--space-10), 9dvh, var(--space-20));<b
                    >&nbsp; max: 80px</b
                  ></i
                >
              </div>
              <div>
                <code>.hf6 </code>:
                <i>
                  height: clamp(var(--space-12), 11dvh, var(--space-24));<b
                    >&nbsp; max: 96px
                  </b></i
                >
              </div>
              <div>
                <code>.hf7 </code>:
                <i>
                  height: clamp(var(--space-16), 15dvh, var(--space-32));<b
                    >&nbsp; max: 128px
                  </b></i
                >
              </div>
              <div>
                <code>.hf8 </code>:
                <i>
                  height: clamp(var(--space-20), 22dvh, calc(var(--space-32) *
                  1.5));<b>&nbsp; max: 192px </b></i
                >
              </div>
              <div>
                <code>.hf9 </code>:
                <i>
                  height: clamp(var(--space-24), 28dvh, calc(var(--space-32) *
                  2));<b>&nbsp; max: 256px </b></i
                >
              </div>
              <div>
                <code>.hf10 </code>:
                <i>
                  height: clamp(var(--space-32), 35dvh, calc(var(--space-32) *
                  2.5));<b>&nbsp; max: 320px </b></i
                >
              </div>
              <div>
                <code>.hf11 </code>:
                <i>
                  height: clamp(var(--space-32), 42dvh, calc(var(--space-32) *
                  3));<b>&nbsp; max: 384px </b></i
                >
              </div>
              <div>
                <code>.hf12 </code>:
                <i>
                  height: clamp(var(--space-32), 50dvh, calc(var(--space-32) *
                  3.5));<b>&nbsp; max: 448px </b></i
                >
              </div>
              <div>
                <code>.hf13 </code>:
                <i>
                  height: clamp(var(--space-32), 60dvh, calc(var(--space-32) *
                  4));<b>&nbsp; max: 512px </b></i
                >
              </div>
              <div>
                <code>.hf14 </code>:
                <i>
                  height: clamp(var(--space-32), 75dvh, calc(var(--space-32) *
                  5));<b>&nbsp; max: 640px </b></i
                >
              </div>
              <div>
                <code>.hf15 </code>:
                <i>
                  height: clamp(var(--space-32), 90dvh, calc(var(--space-32) *
                  6));<b>&nbsp; max: 768px </b></i
                >
              </div>
            </div>
          </div>
          <div class="separator-v"></div>
          <div class="row ai-fs">
            <div>
              <i>.h1</i>
              <div class="bg-1 h1 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf1</i>
              <div class="bg-1 hf1 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h2</i>
              <div class="bg-1 h2 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf2</i>
              <div class="bg-1 hf2 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h3</i>
              <div class="bg-1 h3 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf3</i>
              <div class="bg-1 hf3 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h4</i>
              <div class="bg-1 h4 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf4</i>
              <div class="bg-1 hf4 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h5</i>
              <div class="bg-1 h5 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf5</i>
              <div class="bg-1 hf5 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h6</i>
              <div class="bg-1 h6 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf6</i>
              <div class="bg-1 hf6 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h7</i>
              <div class="bg-1 h7 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf7</i>
              <div class="bg-1 hf7 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h8</i>
              <div class="bg-1 h8 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf8</i>
              <div class="bg-1 hf8 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h9</i>
              <div class="bg-1 h9 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf9</i>
              <div class="bg-1 hf9 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h10</i>
              <div class="bg-1 h10 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf10</i>
              <div class="bg-1 hf10 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h11</i>
              <div class="bg-1 h11 border marg-xs padd-h-s wfc bordered"></div>
            </div>

            <div>
              <i>.hf11</i>
              <div class="bg-1 hf11 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h12</i>
              <div class="bg-1 h12 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf12</i>
              <div class="bg-1 hf12 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h13</i>
              <div class="bg-1 h13 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf13</i>
              <div class="bg-1 hf13 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h14</i>
              <div class="bg-1 h14 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf14</i>
              <div class="bg-1 hf14 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div class="separator-h-s"></div>

            <div>
              <i>.h15</i>
              <div class="bg-1 h15 border marg-xs padd-h-s wfc bordered"></div>
            </div>
            <div>
              <i>.hf15</i>
              <div class="bg-1 hf15 border marg-xs padd-h-s wfc bordered"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
